<!DOCTYPE html>
<html themes-data-theme="light">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Items
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫</text><text y=%222.0em%22 x=%220.2em%22 font-size=%2248%22 fill=%22%23eee%22>IMS</text></svg>">

		{# Prevent FOUC, (Flash Of Unstyled Content) #}
		<script src="{{ asset('assets/js/prevent-fouc.js') }}"></script>
		{# CSS asset #}
		<link rel="preload" href="{{ asset('assets/css/themes.css') }}" as="style" media="all" onload="this.rel='stylesheet'">
		<noscript><link rel="stylesheet" href="{{ asset('assets/css/themes.css') }}" media="all"></noscript>
		{# JavaScript assets #}
		<script src="{{ asset('assets/js/themes.js') }}" defer></script>
		<script src="{{ asset('assets/js/contact-form.js') }}" defer></script>
		<script src="{{ asset('assets/js/mobile-modal-menu-overlay.js') }}" defer></script>
	</head>
	<body class="wrapper">
		{# Skip link: allows keyboard users to skip navigation and access the main content directly #}
		<a href="#main-content" class="skip-link">Skip to main content</a>
		{# Header with logo, menu and theme button #}
		<header class="header">
			<div
				class="container header-inner">

				{# button to change theme #}
				<button id="theme-toggle" class="btn" aria-label="Change theme"></button>

				<!-- the script will update the content -->
				<a href="{{ path('app_item_index') }}" class="logo">Items</a>

				{# button hamburger for mobile only) #}
				<button id="nav-toggle" class="nav-toggle" aria-label="Open menu">
					☰
				</button>

				{# main navigation list #}
				<nav id="main-nav" class="nav">
					<ul>
						<li><a href="{{ path('app_landing') }}">Home</a></li>
						<li><a href="{{ path('app_item_new') }}">New</a></li>
					</ul>
				</nav>
			</div>
		</header>

		{# main content - grid-column: 2 - it is already defined in the CSS #}
		<main id="main-content" class="container" role="main">
            {% block body %}{% endblock %}
		</main>

		{# optional footer #}
		<footer class="footer">
			<div class="container footer-inner">
				©️ 2026
				<a href="{{ path('app_landing')}}">Item Management System</a>
				- All rights reserved
			</div>
		</footer>
	</body>
</html>
